+/// Bounded retries per tick (each drops the smallest output).
+const MAX_BUILD_ATTEMPTS: usize = 3;
+
+/// Build at `fee_rate` and run T7/T8: refuse anything that is not exactly the
+/// intended payout, with every output's fee share within the rule.
+async fn build_verified(
+	cfg: &Config, chain: &chain::Chain, outputs: &[(String, u64, Vec<String>)], fee_rate: f64,
+) -> anyhow::Result<(chain::BuiltPayout, Option<ScriptBuf>)> {
+	let mut expected = Vec::with_capacity(outputs.len());
+	for (addr, amt, _) in outputs {
+		let spk = Address::from_str(addr)?.require_network(cfg.network)?.script_pubkey();
+		expected.push((spk, *amt));
+	}
+	let built = chain.build_payout(outputs.iter().map(|o| (o.0.clone(), o.1)).collect(), fee_rate).await?;
+	let change = checks::verify_payout(
+		&built.tx, &expected, built.fee_sat, cfg.policy.max_fee_rate_sat_vb, cfg.policy.max_fee_pct_per_payout,
+	)?;
+	Ok((built, change))
+}
