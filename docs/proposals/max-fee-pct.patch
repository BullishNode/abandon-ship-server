+/// P2TR dust limit at Core's default `dustrelayfee` (3 sat/vB).
+pub const P2TR_DUST_SAT: u64 = 330;
+
+/// Upper bound on the vsize charged to one payout output. bitcoind splits the
+/// fee equally over all outputs (`subtract_fee_from_outputs`), so the worst
+/// case is a lone output carrying the whole tx: overhead 10.5 + two P2WPKH
+/// inputs 2 x 68 + one P2TR output 43 + P2WPKH change 31 = 220.5 vB. In a
+/// larger batch each output's share is smaller.
+pub const LONE_OUTPUT_VB: u64 = 230;
+
+/// Worst-case fee share of one output at `rate_sat_vb`, rounded up the way
+/// `Chain::build_payout` passes the rate to bitcoind (whole sat per kvB).
+pub fn fee_share_bound(rate_sat_vb: f64) -> u64 {
+	((rate_sat_vb * 1000.0).ceil() as u64 * LONE_OUTPUT_VB).div_ceil(1000)
+}
+
+/// Paying `value` on-chain with fee share `share` is worth it: the share is at
+/// most `max_pct` percent of the value, and the output stays above dust.
+pub fn affordable(value: u64, share: u64, max_pct: u64) -> bool {
+	share * 100 <= max_pct * value && value >= share + P2TR_DUST_SAT
+}
+
+/// The smallest value that is `affordable` with this fee share.
+pub fn min_payable(share: u64, max_pct: u64) -> u64 {
+	(share * 100).div_ceil(max_pct).max(share + P2TR_DUST_SAT)
+}
