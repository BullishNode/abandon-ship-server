# Public signet (the chain Second's ark.signet.2nd.dev runs on), ~10-minute blocks.
STACK=signet
NETWORK=signet
BITCOIND_NET=-signet
CLN_NETWORK=signet
CLN_DIR=signet
BITCOIND_DBCACHE=1000
BITCOIN_VOLUME=bitcoin
BITCOIND_FILTER_INDEXES=1

# captaind: coins live ~1 day so one expiry cycle fits in a working day.
VTXO_LIFETIME=144
POOL_VTXO_LIFETIME=144
VTXO_EXIT_DELTA=12
BOARD_CONFS=2
ROUND_INTERVAL=30s
LN_ANTI_DOS=false
WATCHMAN_TRUSTED_CONFS=1

# sidecar policy
GRACE_BLOCKS=12
SWEEP_MIN_CONFS=6
BAN_BLOCKS=6
BAN_WAIT_SECS=120
MIN_PAYOUT_SAT=500
MAX_FEE_PCT=20

# Amounts sized for a faucet budget (~20k sat total): small boards, no coin pool.
MIN_BOARD_AMOUNT='2000 sat'
VTXO_POOL_TARGETS=[]
MIN_CPFP_AMOUNT='1000 sat'

# bark-web wallet
WEB_NETWORK=signet
WEB_CHAIN_SOURCE=https://esplora.signet.2nd.dev
