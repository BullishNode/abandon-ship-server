# Public signet (the chain Second's ark.signet.2nd.dev runs on), ~10-minute blocks.
STACK=signet
NETWORK=signet
BITCOIND_NET=-signet
CLN_NETWORK=signet
CLN_DIR=signet
BITCOIND_DBCACHE=1000
BITCOIN_VOLUME=bitcoin

# captaind: coins live ~1 day so one expiry cycle fits in a working day.
VTXO_LIFETIME=144
POOL_VTXO_LIFETIME=144
VTXO_EXIT_DELTA=12
BOARD_CONFS=2
ROUND_INTERVAL=30s
LN_ANTI_DOS=false
WATCHMAN_TRUSTED_CONFS=1

# sidecar policy
GRACE_BLOCKS=12
SWEEP_MIN_CONFS=6
BAN_BLOCKS=6
BAN_WAIT_SECS=120
MIN_PAYOUT_SAT=1000
MAX_FEE_PCT=20
