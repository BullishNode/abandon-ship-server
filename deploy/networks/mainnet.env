# Mainnet. Values follow captaind.default.toml at bark 6768e0fb4 and the
# sidecar's mainnet floors (src/config.rs). Real money: see deploy/README.md.
STACK=mainnet
NETWORK=bitcoin
BITCOIND_NET=-chain=main
CLN_NETWORK=mainnet
CLN_DIR=bitcoin
BITCOIND_DBCACHE=8000
# Chain on its own SSD (a 1 TB volume with a Core 27 mainnet datadir, reused).
BITCOIN_VOLUME=/srv/chain/bitcoin
# captaind and the sidecar need only txindex; the chain disk is 1 TB.
BITCOIND_FILTER_INDEXES=0

VTXO_LIFETIME=4320
POOL_VTXO_LIFETIME=432
VTXO_EXIT_DELTA=144
BOARD_CONFS=3
ROUND_INTERVAL=10s
LN_ANTI_DOS=true
WATCHMAN_TRUSTED_CONFS=2

GRACE_BLOCKS=1008
SWEEP_MIN_CONFS=100
BAN_BLOCKS=6
BAN_WAIT_SECS=120
MIN_PAYOUT_SAT=10000
MAX_FEE_PCT=20

MIN_BOARD_AMOUNT='20000 sat'
VTXO_POOL_TARGETS='[ "10000sat:10", "1000000sat:10" ]'
MIN_CPFP_AMOUNT='10000 sat'

# bark-web wallet
WEB_NETWORK=mainnet
WEB_CHAIN_SOURCE=https://mempool.second.tech/api
