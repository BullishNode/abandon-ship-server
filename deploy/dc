#!/bin/sh
# docker compose for one stack: ./dc <signet|mainnet> <compose args...>
set -eu
cd "$(dirname "$0")"
stack=${1:?usage: ./dc <signet|mainnet> <compose args>}; shift
[ -f "state/$stack/secrets.env" ] || { echo "run ./render.sh $stack first" >&2; exit 1; }
exec docker compose -p "abandon-$stack" --env-file "networks/$stack.env" --env-file "state/$stack/secrets.env" -f compose.yaml "$@"
