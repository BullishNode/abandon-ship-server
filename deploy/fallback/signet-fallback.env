# Expiry-fallback fork (BullishNode/abandon-ship-bark expiry-fallback @ d47c6a4d1)
# beside the signet stack. Shares that stack's bitcoind over RPC only.
STACK=signet-fallback
NETWORK=signet
FORK_COMMIT=d47c6a4d1
# bark-web at d47b3ae (no legacy payout lookup; a failed expired-coin check keeps
# expired coins out of auto-refresh). bark-web-api is unchanged since ed67568.
WEB_TAG=release-d47b3ae
WEB_API_TAG=ed67568

# Signet test lifetime: delegated replacement safety needs two wallet exit
# margins (12 each) plus the input exit delta (12), with confirmation slack.
# Existing coins keep their signed expiry heights; this applies to new coins.
VTXO_LIFETIME=48
POOL_VTXO_LIFETIME=48
VTXO_EXIT_DELTA=12
BOARD_CONFS=2
ROUND_INTERVAL=30s
LN_ANTI_DOS=false
WATCHMAN_TRUSTED_CONFS=1
MIN_BOARD_AMOUNT='2000 sat'
VTXO_POOL_TARGETS=[]
# Empty keeps the standalone stack without Lightning. Set only after installing
# the simulator node's mTLS files in ignored state/signet-fallback/simulation-cln.
SIMULATION_LIGHTNING_HOST=
MIN_CPFP_AMOUNT='1000 sat'

# [expiry_payout]: signet rehearsal timings; min_payout_sat is the owner ruling
# (1,000 sat, set explicitly).
EXPIRY_INTERVAL=30s
EXPIRY_GRACE_BLOCKS=6
EXPIRY_SWEEP_MIN_CONFS=6
EXPIRY_MIN_PAYOUT_SAT=1000
EXPIRY_CONF_TARGET=6
