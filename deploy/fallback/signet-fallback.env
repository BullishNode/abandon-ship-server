# Expiry-fallback fork (BullishNode/abandon-ship-bark expiry-fallback @ 223aaf82c)
# beside the signet stack. Shares that stack's bitcoind over RPC only.
STACK=signet-fallback
NETWORK=signet
FORK_COMMIT=223aaf82c

# captaind. Lifetime 24 = 2 board confirmations + bark's signet exit margin (12)
# + 10 blocks of slack for a slow board confirmation. Shorter lifetimes make
# an unregistered board start an exit (bark/src/actions/board.rs).
VTXO_LIFETIME=24
POOL_VTXO_LIFETIME=24
VTXO_EXIT_DELTA=12
BOARD_CONFS=2
ROUND_INTERVAL=30s
LN_ANTI_DOS=false
WATCHMAN_TRUSTED_CONFS=1
MIN_BOARD_AMOUNT='2000 sat'
VTXO_POOL_TARGETS=[]
MIN_CPFP_AMOUNT='1000 sat'

# [expiry_payout]: signet rehearsal timings; min_payout_sat is the owner ruling.
EXPIRY_INTERVAL=30s
EXPIRY_GRACE_BLOCKS=6
EXPIRY_SWEEP_MIN_CONFS=6
EXPIRY_MIN_PAYOUT_SAT=10000
EXPIRY_MAX_BATCH=100
EXPIRY_CONF_TARGET=6
